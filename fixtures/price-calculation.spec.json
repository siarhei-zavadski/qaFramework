{
  "fields": [
    {
      "name": "price",
      "type": "number",
      "step": 0.1,
      "partitions": [
        {"label": "low", "min": 0, "max": 100},
        {"label": "mid", "min": 100.1, "max": 199.9},
        {"label": "high", "min": 200}
      ]
    },
    {
      "name": "weight",
      "type": "number",
      "step": 0.1,
      "partitions": [
        {"label": "light", "min": 0, "max": 4.9},
        {"label": "heavy", "min": 5}
      ]
    },
    {
      "name": "card",
      "type": "enum",
      "invalid": [],
      "partitions": [
        {"label": "no", "values": [false]},
        {"label": "yes", "values": [true]}
      ]
    }
  ],
  "rules": [
    {
      "when": {"price": "high", "card": "yes", "weight": "light"},
      "expected": "0.85 * price"
    },
    {
      "when": {"price": "high", "card": "yes"},
      "expected": "0.9 * 0.97 * price"
    },
    {"when": {"price": "high"}, "expected": "0.9 * price"},
    {
      "when": {"price": "low", "weight": "heavy", "card": "yes"},
      "expected": "0.97 * price + weight"
    },
    {"when": {"price": "low", "weight": "heavy"}, "expected": "price + weight"},
    {"when": {"card": "yes"}, "expected": "0.97 * price"},
    {"when": {}, "expected": "price"}
  ]
}
