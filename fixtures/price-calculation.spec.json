{
  "fields": [
    {
      "name": "price",
      "type": "number",
      "step": 0.1,
      "partitions": [
        {"label": "low", "min": 0, "max": 100},
        {"label": "mid", "min": 100.1, "max": 199.9},
        {"label": "high", "min": 200}
      ]
    },
    {
      "name": "weight",
      "type": "number",
      "step": 0.1,
      "partitions": [
        {"label": "light", "min": 0, "max": 4.9},
        {"label": "heavy", "min": 5}
      ]
    },
    {
      "name": "card",
      "type": "enum",
      "invalid": [],
      "partitions": [
        {"label": "no", "values": [false]},
        {"label": "yes", "values": [true]}
      ]
    }
  ],
  "rules": [
    {
      "when": {"price": "high", "card": "yes", "weight": "light"},
      "expected": "=round(0.85 * price, 0.1)"
    },
    {
      "when": {"price": "high", "card": "yes"},
      "expected": "=round(0.9 * 0.97 * price, 0.1)"
    },
    {"when": {"price": "high"}, "expected": "=round(0.9 * price, 0.1)"},
    {
      "when": {"price": "low", "weight": "heavy", "card": "yes"},
      "expected": "=round(0.97 * price + weight, 0.1)"
    },
    {
      "when": {"price": "low", "weight": "heavy"},
      "expected": "=round(price + weight, 0.1)"
    },
    {"when": {"card": "yes"}, "expected": "=round(0.97 * price, 0.1)"},
    {"when": {}, "expected": "=round(price, 0.1)"}
  ]
}
